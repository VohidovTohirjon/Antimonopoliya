DATABASE_URL=postgresql+psycopg://raqobat:raqobat@localhost:5432/raqobat
SECRET_KEY=replace-with-at-least-32-random-characters
# --- LLM provayder ---
# "local" = o'z serveringizdagi OpenAI-mos endpoint (vLLM), "groq" = tashqi xizmat.
LLM_PROVIDER=local
# Zaxira provayder faqat shu bayroq bilan yoqiladi; avtomatik ishlatilmaydi.
LLM_FALLBACK_ENABLED=false
# Faqat diagnostika uchun provayderni majburan o'chirish.
LLM_FORCE_UNAVAILABLE=false

# --- Lokal vLLM server ---
LOCAL_LLM_BASE_URL=http://LLM_SERVER_HOST:8000/v1
# vLLM --api-key bilan ishga tushirilgan bo'lsa to'ldiring; aks holda bo'sh qoldiring.
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=openai/gpt-oss-20b
# Ixtiyoriy qo'shimcha modellar, vergul bilan.
LOCAL_LLM_MODELS=
LOCAL_LLM_TIMEOUT_SECONDS=120
LOCAL_LLM_MAX_TOKENS=3200
# Server OpenAI json_schema formatini qo'llab-quvvatlasa true qoldiring.
LOCAL_LLM_STRICT_SCHEMA=true
LOCAL_LLM_REASONING_EFFORT=

# --- Groq (ixtiyoriy zaxira) ---
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.6-27b,openai/gpt-oss-20b,groq/compound,groq/compound-mini
ALLOW_EXTERNAL_CONFIDENTIAL_AI=false
GROQ_FORCE_UNAVAILABLE=false
GROQ_MAX_TOKENS=3200
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_DIMENSIONS=1024
EMBEDDING_WARMUP_ON_STARTUP=true
RETRIEVAL_MIN_SCORE=0.48
RETRIEVAL_CANDIDATE_LIMIT=60
DATA_DIR=data
# FAQAT DEVELOPMENT. Lokal seed YANGI yaratadigan hisoblar paroli.
# Mavjud hisob paroliga hech qachon tegmaydi. Productionda o‘rnatilmasin.
LOCAL_SEED_PASSWORD=12345678
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
VITE_API_URL=http://localhost:8000
