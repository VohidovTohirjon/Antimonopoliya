# Production namunasi — bitta VM, Nginx same-origin, host'dagi vLLM.
# Bu faylni `.env` ga nusxalab, <...> qiymatlarini to'ldiring. Haqiqiy sirlarni
# hech qachon repozitoriyga commit qilmang.

APP_ENV=production

# --- Xavfsizlik ---
# openssl rand -hex 32
SECRET_KEY=<kamida-32-belgili-tasodifiy-qiymat>

# --- PostgreSQL (compose ichida, tashqariga ochilmaydi) ---
POSTGRES_DB=raqobat
POSTGRES_USER=raqobat
POSTGRES_PASSWORD=<kuchli-db-paroli>
# DATABASE_URL ni compose avtomatik beradi; qo'lda ishga tushirsangiz:
# DATABASE_URL=postgresql+psycopg://raqobat:<kuchli-db-paroli>@db:5432/raqobat

# --- LLM: lokal vLLM majburiy ---
# APP_ENV=production bo'lganda LLM_PROVIDER aniq yozilishi SHART.
# Aks holda backend ishga tushmaydi (tasodifan Groq yoqilib qolmasligi uchun).
LLM_PROVIDER=local
LLM_FALLBACK_ENABLED=false
LLM_FORCE_UNAVAILABLE=false

LOCAL_LLM_BASE_URL=http://host.docker.internal:8001/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=openai/gpt-oss-20b
LOCAL_LLM_TIMEOUT_SECONDS=120
LOCAL_LLM_STRICT_SCHEMA=true
LOCAL_LLM_REASONING_EFFORT=low

LLM_MAX_TOKENS_GENERAL=512
LLM_MAX_TOKENS_LEGAL=1024
LLM_MAX_TOKENS_DOCUMENT=1024
LLM_MAX_TOKENS_DRAFTING=3200

# --- Groq ishlatilmaydi ---
GROQ_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_DIMENSIONS=1024
EMBEDDING_WARMUP_ON_STARTUP=true
RETRIEVAL_MIN_SCORE=0.48
RETRIEVAL_CANDIDATE_LIMIT=60

# --- Same-origin: Nginx orqali xizmat qilinadi ---
# Frontend /api ni o'z hostida chaqiradi, shuning uchun CORS kerak emas.
CORS_ORIGINS=
VITE_API_URL=

DATA_DIR=/app/data
